# NASA API Key (optional — EONET works without it but higher rate limits with one)
# Get yours at: https://api.nasa.gov/
NASA_API_KEY=your_key_here

# Database URL (default: SQLite in data/ folder)
# Swap to PostgreSQL later: postgresql://user:pass@localhost:5432/disaster_intel
DATABASE_URL=sqlite:///data/disaster_intel.db
